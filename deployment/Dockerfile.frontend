# 第一阶段：构建应用
FROM node:18-alpine AS builder

# 设置工作目录
WORKDIR /app

# 构建参数
ARG NPM_REGISTRY=https://registry.npmmirror.com

# ✅ 优化 1: 配置 Alpine 国内镜像源（阿里云）- 解决网络问题
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# ✅ 优化 2: 安装构建依赖（Alpine 需要这些来编译原生模块）
RUN apk add --no-cache python3 make g++

# ✅ 优化 3: 配置 npm 镜像源
RUN npm config set registry ${NPM_REGISTRY}

# 复制 package.json 和 package-lock.json
COPY package*.json ./

# ✅ 优化 4: 先清理缓存，然后安装所有依赖（包括 devDependencies，因为需要构建）
# 不使用 --only=production，因为构建需要 devDependencies
RUN npm cache clean --force && \
    rm -rf node_modules package-lock.json && \
    npm install

# 复制项目文件
COPY . .

# 构建生产版本
RUN npm run build

# 第二阶段：使用 Nginx 提供静态文件服务
FROM nginx:1.25-alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx配置将在docker-compose中通过卷挂载注入
# 或者构建前将nginx.conf复制到正确位置

# 暴露端口
EXPOSE 80

# 启动 Nginx
CMD ["nginx", "-g", "daemon off;"]
