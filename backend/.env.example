# ==================== Gemini Image API 配置 ====================
# 用于生成高质量 PPT 页面图片 (Imagen 3 / Nano Banana Pro)
# 
# 获取方式：
# 1. 访问 https://aistudio.google.com/app/apikey
# 2. 创建 API Key
# 3. 将 Key 填入下方

# Gemini API Key (必填)
GEMINI_IMAGE_API_KEY=your_gemini_api_key_here

# Gemini API Base URL (可选，默认使用 Google 官方地址)
# GEMINI_IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Gemini Image 模型 (可选，默认使用 Imagen 3)
# GEMINI_IMAGE_MODEL=imagen-3.0-generate-001

# ==================== 其他配置 ====================
# MongoDB 配置
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=project_management

# OSS 配置 (可选)
# OSS_PROVIDER=aliyun
# OSS_ACCESS_KEY_ID=your_access_key
# OSS_ACCESS_KEY_SECRET=your_secret_key
# OSS_BUCKET_NAME=your_bucket
# OSS_REGION=cn-hangzhou

# 阿里云语音识别配置 (可选)
# DASHSCOPE_API_KEY=your_dashscope_key
